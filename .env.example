# ============================================================
# RECHARGE CRM BACKEND — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in all values before running
# ============================================================

# ─── APP ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
APP_NAME=RechPays
APP_VERSION=1.0.0
APP_URL=https://api.rechpays.in
FRONTEND_URL=https://rechpays.in

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://rechpays.in

# ─── MONGODB ─────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/rechargecrmdb?retryWrites=true&w=majority
MONGO_DB_NAME=rechargecrmdb

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_64_characters_long_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_64_characters_long
JWT_REFRESH_EXPIRES_IN=7d

# ─── BCRYPT ──────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── RATE LIMITING ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
RECHARGE_RATE_LIMIT_MAX=30

# ─── REDIS (Bull queues, caching) ────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── COOKIE ──────────────────────────────────────────────────
COOKIE_SECRET=your_cookie_secret_min_32_characters_here
COOKIE_DOMAIN=localhost

# ─── EMAIL (SMTP) ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=RechargeCRM
SMTP_FROM_EMAIL=noreply@rechargecrmapp.com

# ─── ACCOUNT LOCK ────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30

# ─── MROBOTICS PROVIDER ──────────────────────────────────────
MROBOTICS_BASE_URL=https://api.mrobotics.in
MROBOTICS_API_KEY=your_mrobotics_api_key
MROBOTICS_API_SECRET=your_mrobotics_api_secret
MROBOTICS_MEMBER_ID=your_mrobotics_member_id
MROBOTICS_TIMEOUT_MS=30000
MROBOTICS_RETRY_COUNT=3
MROBOTICS_RETRY_DELAY_MS=1000

# ─── RETRY ENGINE ────────────────────────────────────────────
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=1000
RETRY_BACKOFF_MULTIPLIER=2
RETRY_MAX_DELAY_MS=30000

# ─── WEBHOOK ─────────────────────────────────────────────────
WEBHOOK_SECRET=your_webhook_hmac_secret_min_32_chars
WEBHOOK_TOLERANCE_SECONDS=300

# ─── API KEY ENCRYPTION ──────────────────────────────────────
API_KEY_ENCRYPTION_SECRET=your_aes_256_encryption_key_32_chars_here

# ─── LOGGING ─────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# ─── SWAGGER ─────────────────────────────────────────────────
SWAGGER_ENABLED=true

# ─── WALLET ──────────────────────────────────────────────────
WALLET_DEFAULT_LIMIT=100000
WALLET_MIN_RECHARGE_AMOUNT=10
WALLET_MAX_RECHARGE_AMOUNT=10000
COMMISSION_RATE=0.02

# ─── CRON ────────────────────────────────────────────────────
CRON_RETRY_SCHEDULE=*/5 * * * *
CRON_PENDING_CHECK_SCHEDULE=*/10 * * * *
CRON_LOG_CLEANUP_SCHEDULE=0 2 * * *
CRON_SETTLEMENT_SCHEDULE=0 0 * * *

# ─── PAGINATION ──────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ─── UPLOAD ──────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
