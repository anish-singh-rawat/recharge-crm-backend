{
  "name": "recharge-crm-backend",
  "version": "1.0.0",
  "description": "Production-ready Recharge Reseller CRM Backend - Node.js, Express, MongoDB",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "NODE_ENV=production node src/server.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop recharge-crm-backend",
    "pm2:restart": "pm2 restart recharge-crm-backend",
    "pm2:logs": "pm2 logs recharge-crm-backend",
    "dev": "nodemon src/server.js",
    "seed": "node src/jobs/seed.js",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix"
  },
  "keywords": [
    "recharge",
    "crm",
    "bbps",
    "fintech",
    "wallet",
    "payment",
    "reseller"
  ],
  "author": "Recharge CRM",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.0.5",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cron-parser": "^5.7.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "glob": "^13.0.6",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "nodemon": "^3.1.9"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "js,json",
    "ignore": [
      "logs/*",
      "uploads/*"
    ],
    "delay": 1000
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": true,
    "@scarf/scarf@1.4.0": true
  }
}
